<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ruoyi.mapper.skill.UserSkillMapper">

    <!-- 通用查询结果映射 -->
    <resultMap id="BaseResultMap" type="org.ruoyi.domain.entity.skill.UserSkill">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="skill_name" property="skillName"/>
        <result column="skill_code" property="skillCode"/>
        <result column="skill_type" property="skillType"/>
        <result column="description" property="description"/>
        <result column="skill_config" property="skillConfig"/>
        <result column="skill_code_content" property="skillCodeContent"/>
        <result column="file_path" property="filePath"/>
        <result column="is_enabled" property="isEnabled"/>
        <result column="is_public" property="isPublic"/>
        <result column="test_result" property="testResult"/>
        <result column="test_time" property="testTime"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="del_flag" property="delFlag"/>
        <result column="tenant_id" property="tenantId"/>
    </resultMap>

    <!-- 通用查询列 -->
    <sql id="Base_Column_List">
        id, user_id, skill_name, skill_code, skill_type, description, skill_config, 
        skill_code_content, file_path, is_enabled, is_public, test_result, test_time,
        create_by, create_time, update_by, update_time, del_flag, tenant_id
    </sql>

    <!-- 查询用户技能列表 -->
    <select id="selectUserSkillList" parameterType="map" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM user_skill
        WHERE del_flag = '0'
        <if test="userId != null and userId != 0">
            AND user_id = #{userId}
        </if>
        <if test="skillType != null and skillType != ''">
            AND skill_type = #{skillType}
        </if>
        <if test="isEnabled != null and isEnabled != ''">
            AND is_enabled = #{isEnabled}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (skill_name LIKE CONCAT('%', #{keyword}, '%') 
                 OR description LIKE CONCAT('%', #{keyword}, '%')
                 OR skill_code LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- 根据技能编码查询 -->
    <select id="selectBySkillCode" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM user_skill
        WHERE skill_code = #{skillCode}
          AND tenant_id = #{tenantId}
          AND del_flag = '0'
        LIMIT 1
    </select>

    <!-- 根据用户 ID 查询启用的技能列表 -->
    <select id="selectEnabledByUserId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM user_skill
        WHERE user_id = #{userId}
          AND is_enabled = 'Y'
          AND del_flag = '0'
        ORDER BY create_time DESC
    </select>

    <!-- 根据用户 ID 和技能 ID 列表查询技能 -->
    <select id="selectListByUserAndIds" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM user_skill
        WHERE user_id = #{userId}
          AND del_flag = '0'
          <if test="ids != null and ids.size() > 0">
              AND id IN
              <foreach collection="ids" item="id" open="(" separator="," close=")">
                  #{id}
              </foreach>
          </if>
        ORDER BY create_time DESC
    </select>

    <!-- 更新技能测试结果 -->
    <update id="updateTestResult">
        UPDATE user_skill
        SET test_result = #{testResult},
            test_time = #{testTime},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 批量启用/禁用技能 -->
    <update id="batchUpdateEnabled">
        UPDATE user_skill
        SET is_enabled = #{isEnabled},
            update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
