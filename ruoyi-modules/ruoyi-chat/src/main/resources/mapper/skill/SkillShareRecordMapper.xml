<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ruoyi.mapper.skill.SkillShareRecordMapper">

    <resultMap id="BaseResultMap" type="org.ruoyi.domain.entity.skill.SkillShareRecord">
        <id column="id" property="id"/>
        <result column="skill_id" property="skillId"/>
        <result column="skill_name" property="skillName"/>
        <result column="from_user_id" property="fromUserId"/>
        <result column="from_user_name" property="fromUserName"/>
        <result column="to_user_id" property="toUserId"/>
        <result column="to_user_name" property="toUserName"/>
        <result column="share_type" property="shareType"/>
        <result column="status" property="status"/>
        <result column="message" property="message"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="tenant_id" property="tenantId"/>
    </resultMap>

    <select id="selectPendingByUserId" resultMap="BaseResultMap">
        SELECT * FROM skill_share_record
        WHERE to_user_id = #{userId}
        AND status = 'PENDING'
        ORDER BY create_time DESC
    </select>

    <select id="selectByFromUserId" resultMap="BaseResultMap">
        SELECT * FROM skill_share_record
        WHERE from_user_id = #{userId}
        ORDER BY create_time DESC
    </select>

</mapper>